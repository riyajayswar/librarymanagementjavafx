<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controller.LoginController"
           prefWidth="1200"
           prefHeight="700"
           style="-fx-background-color:linear-gradient(to bottom right,#0f172a,#1e293b);">

    <HBox alignment="CENTER"
          spacing="70">

        <!-- LEFT SIDE -->
        <VBox alignment="CENTER_LEFT"
              spacing="25"
              prefWidth="500">

            <Label text="Library Management System"
                   style="-fx-text-fill:white;
                          -fx-font-size:48;
                          -fx-font-weight:bold;" />

            <Label text="Modern JavaFX Desktop Application"
                   style="-fx-text-fill:#cbd5e1;
                          -fx-font-size:20;" />

            <VBox spacing="15">

                <Label text="Add &amp; Manage Books"
                       style="-fx-text-fill:white;
                              -fx-font-size:18;" />

                <Label text="Issue &amp; Return System"
                       style="-fx-text-fill:white;
                              -fx-font-size:18;" />

                <Label text="Student Registration &amp; Login"
                       style="-fx-text-fill:white;
                              -fx-font-size:18;" />

                <Label text="Fine Calculation"
                       style="-fx-text-fill:white;
                              -fx-font-size:18;" />

                <Label text="Advanced Dashboard Analytics"
                       style="-fx-text-fill:white;
                              -fx-font-size:18;" />

            </VBox>

        </VBox>

        <!-- LOGIN CARD -->
        <VBox alignment="CENTER"
              spacing="20"
              prefWidth="420"
              prefHeight="560"
              style="-fx-background-color:white;
                     -fx-background-radius:30;
                     -fx-padding:40;
                     -fx-effect:
                     dropshadow(gaussian,
                     rgba(0,0,0,0.25),
                     25,0,0,8);">

            <Label text="Welcome Back"
                   style="-fx-font-size:32;
                          -fx-font-weight:bold;
                          -fx-text-fill:#0f172a;" />

            <Label text="Login to continue"
                   style="-fx-text-fill:#64748b;
                          -fx-font-size:15;" />

            <!-- EMAIL -->
            <TextField fx:id="usernameField"
                       promptText="Enter Email"
                       prefWidth="300"
                       prefHeight="45"
                       style="-fx-background-radius:15;
                              -fx-font-size:14;
                              -fx-padding:10;" />

            <!-- PASSWORD -->
            <PasswordField fx:id="passwordField"
                           promptText="Enter Password"
                           prefWidth="300"
                           prefHeight="45"
                           style="-fx-background-radius:15;
                                  -fx-font-size:14;
                                  -fx-padding:10;" />

            <!-- ROLE -->
            <ComboBox fx:id="roleBox"
                      promptText="Select Role"
                      prefWidth="300"
                      prefHeight="45"
                      style="-fx-background-radius:15;" />

            <!-- LOGIN BUTTON -->
            <Button text="LOGIN"
                    onAction="#handleLogin"
                    prefWidth="300"
                    prefHeight="48"
                    style="-fx-background-color:#2563eb;
                           -fx-text-fill:white;
                           -fx-font-size:16;
                           -fx-font-weight:bold;
                           -fx-background-radius:15;" />

            <!-- REGISTER BUTTON -->
            <Button text="REGISTER STUDENT"
                    onAction="#handleRegister"
                    prefWidth="300"
                    prefHeight="48"
                    style="-fx-background-color:#22c55e;
                           -fx-text-fill:white;
                           -fx-font-size:16;
                           -fx-font-weight:bold;
                           -fx-background-radius:15;" />

            <!-- MESSAGE -->
            <Label fx:id="messageLabel"
                   style="-fx-text-fill:#ef4444;
                          -fx-font-size:14;
                          -fx-font-weight:bold;" />

            <!-- ADMIN LOGIN -->
            <VBox alignment="CENTER"
                  spacing="5">

                <Label text="Admin Login"
                       style="-fx-text-fill:#64748b;
                              -fx-font-size:13;
                              -fx-font-weight:bold;" />

                <Label text="Username: admin"
                       style="-fx-text-fill:#64748b;
                              -fx-font-size:12;" />

                <Label text="Password: admin123"
                       style="-fx-text-fill:#64748b;
                              -fx-font-size:12;" />

            </VBox>

        </VBox>

    </HBox>

</StackPane>