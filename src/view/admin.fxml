<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AdminController"
            stylesheets="@style.css"
            prefWidth="1400"
            prefHeight="900"
            styleClass="light-mode">

    <!-- TOPBAR -->
    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="topbar"
              style="-fx-padding:18;">

            <Label text="Library Management Dashboard"
                   style="-fx-text-fill:white;
                          -fx-font-size:30;
                          -fx-font-weight:bold;" />

            <Region HBox.hgrow="ALWAYS"/>

            <ToggleButton fx:id="themeToggle"
                          text="🌙 Theme"
                          onAction="#toggleTheme"
                          style="-fx-background-color:#334155;
                                 -fx-text-fill:white;
                                 -fx-font-weight:bold;
                                 -fx-background-radius:10;" />

            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color:#ef4444;
                           -fx-text-fill:white;
                           -fx-font-weight:bold;
                           -fx-background-radius:10;" />

        </HBox>

    </top>

    <!-- SIDEBAR -->
    <left>

        <VBox spacing="20"
              prefWidth="240"
              styleClass="sidebar"
              style="-fx-padding:25;">

            <Label text="ADMIN PANEL"
                   style="-fx-text-fill:white;
                          -fx-font-size:24;
                          -fx-font-weight:bold;" />

            <Separator />

            <Button text="Dashboard"
                    style="-fx-background-color:#2563eb;
                           -fx-text-fill:white;
                           -fx-background-radius:10;
                           -fx-pref-height:45;
                           -fx-font-size:15;" />

            <Button text="Manage Books"
                    style="-fx-background-color:#334155;
                           -fx-text-fill:white;
                           -fx-background-radius:10;
                           -fx-pref-height:45;
                           -fx-font-size:15;" />

            <Button text="Issued Books"
                    style="-fx-background-color:#334155;
                           -fx-text-fill:white;
                           -fx-background-radius:10;
                           -fx-pref-height:45;
                           -fx-font-size:15;" />

            <Button text="Analytics"
                    style="-fx-background-color:#334155;
                           -fx-text-fill:white;
                           -fx-background-radius:10;
                           -fx-pref-height:45;
                           -fx-font-size:15;" />

        </VBox>

    </left>

    <!-- CENTER -->
    <center>

        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:transparent;">

            <content>

                <VBox spacing="25">

                    <padding>
                        <Insets top="25"
                                right="25"
                                bottom="25"
                                left="25"/>
                    </padding>

                    <!-- DASHBOARD CARDS -->
                    <HBox spacing="20">

                        <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Total Books"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="totalBooksLabel"
                                   text="0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;
                                          -fx-text-fill:#2563eb;" />

                        </VBox>

                        <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Issued Books"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="issuedBooksLabel"
                                   text="0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;
                                          -fx-text-fill:#f59e0b;" />

                        </VBox>

                        <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Available Books"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="availableBooksLabel"
                                   text="0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;
                                          -fx-text-fill:#22c55e;" />

                        </VBox>

                        <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Overdue Books"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="overdueBooksLabel"
                                   text="0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;
                                          -fx-text-fill:#ef4444;" />

                        </VBox>

                    </HBox>

                    <!-- BOOK MANAGEMENT -->
                    <VBox spacing="20"
                          styleClass="content-panel">

                        <Label text="Book Management"
                               style="-fx-font-size:24;
                                      -fx-font-weight:bold;" />

                        <!-- SEARCH -->
                        <HBox spacing="15">

                            <TextField fx:id="searchField"
                                       promptText="Search books..."
                                       prefWidth="300" />

                            <Button text="Search"
                                    onAction="#handleSearch"
                                    style="-fx-background-color:#2563eb;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:12;" />

                        </HBox>

                        <!-- FORM -->
                        <HBox spacing="15">

                            <TextField fx:id="titleField"
                                       promptText="Book Title"
                                       prefWidth="220" />

                            <TextField fx:id="authorField"
                                       promptText="Author"
                                       prefWidth="220" />

                            <TextField fx:id="categoryField"
                                       promptText="Category"
                                       prefWidth="180" />

                            <TextField fx:id="quantityField"
                                       promptText="Quantity"
                                       prefWidth="120" />

                            <Button text="Add Book"
                                    onAction="#handleAddBook"
                                    style="-fx-background-color:#2563eb;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:12;" />

                            <Button text="Update Book"
                                    onAction="#handleUpdateBook"
                                    style="-fx-background-color:#f59e0b;
                                          -fx-text-fill:white;
                                          -fx-font-weight:bold;
                                          -fx-background-radius:12;" />
                                          
                            <Button text="Delete Selected"
                                    onAction="#handleDeleteBook"
                                    style="-fx-background-color:#ef4444;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:12;" />

                        </HBox>

                        <!-- BOOK TABLE -->
                        <TableView fx:id="bookTable"
                                   prefHeight="350">

                            <columns>

                                <TableColumn fx:id="idColumn"
                                             text="ID"
                                             prefWidth="80"/>

                                <TableColumn fx:id="titleColumn"
                                             text="Book Title"
                                             prefWidth="300"/>

                                <TableColumn fx:id="authorColumn"
                                             text="Author"
                                             prefWidth="220"/>

                                <TableColumn fx:id="categoryColumn"
                                             text="Category"
                                             prefWidth="180"/>

                                <TableColumn fx:id="totalQuantityColumn"
                                             text="Total"
                                             prefWidth="120"/>

                                <TableColumn fx:id="availableQuantityColumn"
                                             text="Available"
                                             prefWidth="140"/>

                            </columns>

                        </TableView>

                    </VBox>

                    <!-- ISSUED BOOKS -->
                    <VBox spacing="20"
                          styleClass="content-panel">

                        <Label text="Issued Books"
                               style="-fx-font-size:24;
                                      -fx-font-weight:bold;" />

                        <TableView fx:id="issueTable"
                                   prefHeight="300">

                            <columns>

                                <TableColumn fx:id="studentColumn"
                                             text="Student"
                                             prefWidth="180"/>

                                <TableColumn fx:id="bookColumn"
                                             text="Book"
                                             prefWidth="250"/>

                                <TableColumn fx:id="issueDateColumn"
                                             text="Issue Date"
                                             prefWidth="180"/>

                                <TableColumn fx:id="dueDateColumn"
                                             text="Due Date"
                                             prefWidth="180"/>

                                <TableColumn fx:id="fineColumn"
                                             text="Fine"
                                             prefWidth="120"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"
                                             prefWidth="140"/>

                            </columns>

                        </TableView>

                    </VBox>

                    <!-- OVERDUE BOOKS -->
                    <VBox spacing="20"
                            styleClass="content-panel">

                            <Label text="Overdue Books"
                                   style="-fx-font-size:24;
                                          -fx-font-weight:bold;" />


                            <TableView fx:id="overdueTable"
                                          prefHeight="250">


                                   <columns>


                                          <TableColumn fx:id="overdueStudentColumn"
                                                        text="Student"
                                                        prefWidth="200"/>


                                          <TableColumn fx:id="overdueBookColumn"
                                                        text="Book"
                                                        prefWidth="300"/>


                                          <TableColumn fx:id="overdueDueDateColumn"
                                                        text="Due Date"
                                                        prefWidth="180"/>


                                          <TableColumn fx:id="overdueFineColumn"
                                                        text="Fine"
                                                        prefWidth="120"/>


                                   </columns>


                            </TableView>


                     </VBox>

                    <!-- ANALYTICS -->
                    <VBox spacing="20"
                          styleClass="content-panel">

                        <Label text="Library Analytics"
                               style="-fx-font-size:24;
                                      -fx-font-weight:bold;" />

                        <HBox spacing="25">

                            <PieChart fx:id="bookPieChart"
                                      prefWidth="450"
                                      prefHeight="350" />

                            <BarChart fx:id="categoryChart"
                                      prefWidth="700"
                                      prefHeight="350">

                                <xAxis>
                                    <CategoryAxis label="Category"/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis label="Books"/>
                                </yAxis>

                            </BarChart>

                        </HBox>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>