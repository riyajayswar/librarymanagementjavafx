<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.StudentController"
            prefWidth="1400"
            prefHeight="950"
            stylesheets="@style.css"
            styleClass="light-mode">

    <!-- ================= TOP BAR ================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="20"
              styleClass="topbar">

            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="Student Dashboard"
                   style="-fx-text-fill:white;
                          -fx-font-size:28;
                          -fx-font-weight:bold;" />

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🌙 Theme"
                    onAction="#toggleTheme"
                    style="-fx-background-color:#334155;
                           -fx-text-fill:white;
                           -fx-background-radius:10;
                           -fx-font-weight:bold;" />

            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color:#ef4444;
                           -fx-text-fill:white;
                           -fx-background-radius:10;
                           -fx-font-weight:bold;" />

        </HBox>

    </top>

    <!-- ================= SIDEBAR ================= -->

    <left>

        <VBox spacing="20"
              prefWidth="240"
              styleClass="sidebar">

            <padding>
                <Insets top="25" right="20" bottom="25" left="20"/>
            </padding>

            <Label text="STUDENT PANEL"
                   style="-fx-text-fill:white;
                          -fx-font-size:24;
                          -fx-font-weight:bold;" />

            <Separator />

            <Button text="Dashboard"
                    style="-fx-background-color:#2563eb;
                           -fx-text-fill:white;
                           -fx-background-radius:10;
                           -fx-pref-height:45;
                           -fx-font-size:15;" />

            <Button text="Search Books"
                    onAction="#goToSearch"
                    style="-fx-background-color:#334155;
                           -fx-text-fill:white;
                           -fx-background-radius:10;
                           -fx-pref-height:45;
                           -fx-font-size:15;" />

        </VBox>

    </left>

    <!-- ================= MAIN CONTENT ================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:transparent;">

            <content>

                <VBox spacing="25">

                    <padding>
                        <Insets top="25"
                                right="25"
                                bottom="25"
                                left="25"/>
                    </padding>

                    <!-- ================= DASHBOARD CARDS ================= -->

                    <HBox spacing="20">

                        <!-- TOTAL BOOKS -->

                        <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Total Books"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="totalBooksLabel"
                                   text="0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;" />

                        </VBox>

                        <!-- ISSUED BOOKS -->

                        <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Issued Books"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="issuedBooksLabel"
                                   text="0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;" />

                        </VBox>

                        <!-- AVAILABLE BOOKS -->

                        <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Available Books"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="availableBooksLabel"
                                   text="0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;" />

                        </VBox>

                        <!--Pending Fine-->

                        <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Pending Fine"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="pendingFineLabel"
                                   text="₹0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;
                                          -fx-text-fill:#ef4444;" />

                         </VBox>

                         <!--Overdue Books-->
                         
                         <VBox spacing="10"
                              prefWidth="250"
                              styleClass="dashboard-card">

                            <Label text="Overdue Books"
                                   style="-fx-font-size:18;" />

                            <Label fx:id="overdueBooksLabel"
                                   text="0"
                                   style="-fx-font-size:36;
                                          -fx-font-weight:bold;
                                          -fx-text-fill:#ef4444;" />

                            </VBox>

                    </HBox>

                    <!-- ================= BOOK SECTION ================= -->

                    <VBox spacing="20"
                          styleClass="content-panel">

                        <Label text="Library Books"
                               style="-fx-font-size:24;
                                      -fx-font-weight:bold;" />

                        <!-- SEARCH -->

                        <HBox spacing="15">

                            <TextField fx:id="searchField"
                                       promptText="Search books..."
                                       prefWidth="300"/>

                            <Button text="Search"
                                    onAction="#handleSearch"
                                    style="-fx-background-color:#2563eb;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:12;" />

                        </HBox>

                        <!-- ACTION BUTTONS -->

                        <HBox spacing="15">

                            <Button text="Issue Selected Book"
                                    onAction="#handleIssueBook"
                                    style="-fx-background-color:#2563eb;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:12;
                                           -fx-pref-height:40;" />

                            <Button text="Return Selected Book"
                                    onAction="#handleReturnBook"
                                    style="-fx-background-color:#f59e0b;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;
                                           -fx-background-radius:12;
                                           -fx-pref-height:40;" />

                        </HBox>

                        <!-- BOOK TABLE -->

                        <TableView fx:id="bookTable"
                                   prefHeight="350">

                            <columns>

                                <TableColumn fx:id="idColumn"
                                             text="ID"
                                             prefWidth="80"/>

                                <TableColumn fx:id="titleColumn"
                                             text="Book Title"
                                             prefWidth="280"/>

                                <TableColumn fx:id="authorColumn"
                                             text="Author"
                                             prefWidth="220"/>

                                <TableColumn fx:id="categoryColumn"
                                             text="Category"
                                             prefWidth="180"/>

                                <TableColumn fx:id="totalQuantityColumn"
                                             text="Total Qty"
                                             prefWidth="140"/>

                                <TableColumn fx:id="availableQuantityColumn"
                                             text="Available Qty"
                                             prefWidth="160"/>

                            </columns>

                        </TableView>

                        <!-- FINE -->

                        <HBox spacing="10"
                              alignment="CENTER_LEFT">

                            <Label text="Last Fine:"
                                   style="-fx-font-size:18;
                                          -fx-font-weight:bold;" />

                            <Label fx:id="fineLabel"
                                   text="₹0"
                                   style="-fx-font-size:20;
                                          -fx-font-weight:bold;
                                          -fx-text-fill:#ef4444;" />

                        </HBox>

                    </VBox>

                    <!-- ================= HISTORY SECTION ================= -->

                    <VBox spacing="20"
                          styleClass="content-panel">

                        <Label text="Borrow History"
                               style="-fx-font-size:24;
                                      -fx-font-weight:bold;" />

                        <TableView fx:id="historyTable"
                                   prefHeight="300">

                            <columns>

                                <TableColumn fx:id="historyBookColumn"
                                             text="Book Title"
                                             prefWidth="250"/>

                                <TableColumn fx:id="issueDateColumn"
                                             text="Issue Date"
                                             prefWidth="160"/>

                                <TableColumn fx:id="dueDateColumn"
                                             text="Due Date"
                                             prefWidth="160"/>

                                <TableColumn fx:id="returnDateColumn"
                                             text="Return Date"
                                             prefWidth="180"/>

                                <TableColumn fx:id="fineColumn"
                                             text="Fine"
                                             prefWidth="120"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>